<Project Sdk="Microsoft.NET.Sdk">

	<!-- Import tModLoader mod properties -->
	<Import Project="..\tModLoader.targets" />

	<!-- General -->
	<PropertyGroup>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>
	<ItemGroup>
	  <PackageReference Include="JsonPatch.Net" Version="5.0.2" />
	  <PackageReference Include="JsonPointer.Net" Version="7.0.1" />
	  <PackageReference Include="JsonSchema.Net" Version="9.2.0" />
	  <PackageReference Include="Krafs.Publicizer" Version="2.3.0">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
		<Publicize Include="tModLoader:Terraria.ModLoader.EquipLoader.GetSearch" />
		<Publicize Include="Daybreak:Daybreak.Common.UI.InputField.lastText" />
	</ItemGroup>

	<!-- References -->
	<ItemGroup>
		<Reference Include="Daybreak">
			<HintPath>lib\compile\Daybreak.dll</HintPath>
		</Reference>
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Schemata\" />
	</ItemGroup>

</Project>